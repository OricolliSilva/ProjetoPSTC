* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: white; /* Letras brancas em toda a página */
}

body {
    background-color: #1E3A8A; /* Fundo azul */
    padding: 20px;
}

/* Retângulo laranja no "Cadastre-se" */
h1 {
    background-color: orange;
    padding: 10px 15px;
    display: block;
    width: fit-content;
    border-radius: 5px;
    margin-bottom: 20px;
}

/* Campos de entrada de dados */
input {
    display: block;
    margin-top: 5px;
    padding: 8px;
    border: none;
    outline: none; /* Remove a borda laranja ao clicar */
    border-radius: 3px;
    color: black; /* Letra escura ao digitar */
}

/* Retângulo laranja no "Finalizar entrada" */
a {
    background-color: orange;
    color: white;
    padding: 10px 20px;
    display: inline-block;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
    margin-top: 10px;
}